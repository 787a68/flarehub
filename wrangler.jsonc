{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flarehub",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/image/download", "/api/image/info", "/v2", "/v2/*", "/token",
      "/github.com", "/github.com/*", "/https://github.com", "/https://github.com/*", "/raw.githubusercontent.com", "/raw.githubusercontent.com/*", "/https://raw.githubusercontent.com", "/https://raw.githubusercontent.com/*",
      "/api.github.com", "/api.github.com/*", "/https://api.github.com", "/https://api.github.com/*", "/codeload.github.com", "/codeload.github.com/*", "/https://codeload.github.com", "/https://codeload.github.com/*",
      "/github.githubassets.com", "/github.githubassets.com/*", "/https://github.githubassets.com", "/https://github.githubassets.com/*", "/gist.github.com", "/gist.github.com/*", "/https://gist.github.com", "/https://gist.github.com/*",
      "/huggingface.co", "/huggingface.co/*", "/https://huggingface.co", "/https://huggingface.co/*", "/cdn-lfs.hf.co", "/cdn-lfs.hf.co/*", "/https://cdn-lfs.hf.co", "/https://cdn-lfs.hf.co/*",
      "/download.docker.com", "/download.docker.com/*", "/https://download.docker.com", "/https://download.docker.com/*"
    ]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "WHITELIST": "",
    "BLACKLIST": "",
    "CASE_INSENSITIVE": "false"
  },
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  }
}
