{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flarehub",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/v2", "/v2/*", "/token",
      "/ghcr.io/*",
      "/quay.io/*",
      "/gcr.io/*",
      "/registry.k8s.io/*",
      "/github.com/*",
      "/raw.githubusercontent.com/*",
      "/api.github.com/*",
      "/codeload.github.com/*",
      "/github.githubassets.com/*",
      "/gist.github.com/*",
      "/gist.githubusercontent.com/*",
      "/objects.githubusercontent.com/*",
      "/github-releases.githubusercontent.com/*",
      "/huggingface.co/*",
      "/cdn-lfs.hf.co/*",
      "/cdn-lfs-us-1.hf.co/*",
      "/download.docker.com/*",
      "/gitlab.com/*",
      "/https:///*", "/https%3A/*", "/https%3a/*"
    ]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "WHITELIST": "",
    "BLACKLIST": "",
    "CASE_INSENSITIVE": "false"
  },
  "placement": {
    "mode": "smart"
  }
}
